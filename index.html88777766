<!-- 
  FILENAME: admin.html
  APP: Govinda HQ (Admin Panel)
  TYPE: Master Control Center
  DATABASE: govinda-e9207
-->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Govinda HQ | Master Admin</title>

    <!-- ICONS & FONTS -->
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        :root {
            --brand: #FF6D00; /* Saffron */
            --dark: #1A1D1F;
            --light: #F4F4F4;
            --white: #ffffff;
            --text: #111;
            --sidebar: 260px;
            --success: #27AE60;
            --danger: #EB5757;
            --warn: #F2C94C;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Manrope', sans-serif; outline: none; }
        body { background: var(--light); color: var(--text); display: flex; height: 100vh; overflow: hidden; }

        /* --- AUTH SCREEN --- */
        #view-auth { position: fixed; inset: 0; background: var(--dark); z-index: 9999; display: flex; align-items: center; justify-content: center; }
        .auth-box { background: white; padding: 40px; width: 380px; border-radius: 16px; text-align: center; box-shadow: 0 20px 50px rgba(0,0,0,0.3); }
        .auth-inp { width: 100%; padding: 14px; border: 1px solid #ddd; border-radius: 8px; margin-bottom: 15px; font-size: 1rem; }
        
        /* --- SIDEBAR --- */
        aside { width: var(--sidebar); background: var(--dark); color: #9A9FA5; display: flex; flex-direction: column; transition: 0.3s; }
        .logo { height: 80px; display: flex; align-items: center; padding: 0 25px; font-weight: 800; font-size: 1.4rem; color: white; border-bottom: 1px solid #2F3336; }
        .logo span { color: var(--brand); margin-right: 10px; }
        
        .nav-list { padding: 20px 15px; overflow-y: auto; flex: 1; }
        .nav-btn { padding: 14px 15px; margin-bottom: 5px; cursor: pointer; border-radius: 10px; font-weight: 600; display: flex; align-items: center; gap: 15px; transition: 0.2s; }
        .nav-btn:hover, .nav-btn.active { background: var(--brand); color: white; }
        .nav-btn i { width: 20px; text-align: center; font-size: 1.1rem; }

        /* --- MAIN CONTENT --- */
        main { flex: 1; display: flex; flex-direction: column; overflow: hidden; position: relative; }
        
        /* HEADER */
        header { height: 80px; background: white; border-bottom: 1px solid #EFEFEF; display: flex; justify-content: space-between; align-items: center; padding: 0 30px; }
        .h-title { font-weight: 800; font-size: 1.5rem; color: var(--dark); }
        
        /* STORE TOGGLE SWITCH */
        .store-switch { display: flex; align-items: center; gap: 10px; padding: 8px 15px; background: #f0f0f0; border-radius: 30px; border: 2px solid transparent; transition: 0.3s; }
        .store-switch.online { background: #E8F5E9; border-color: var(--success); }
        .store-switch.offline { background: #FFEBEE; border-color: var(--danger); }
        
        .content { padding: 30px; overflow-y: auto; flex: 1; }

        /* --- CARDS & GRIDS --- */
        .grid-4 { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 30px; }
        .grid-2 { display: grid; grid-template-columns: 1fr 1.5fr; gap: 20px; }
        
        .card { background: white; padding: 25px; border-radius: 16px; box-shadow: 0 4px 10px rgba(0,0,0,0.02); border: 1px solid #EFEFEF; }
        .kpi-val { font-size: 2.2rem; font-weight: 800; margin-top: 5px; color: var(--dark); }
        .kpi-lbl { font-size: 0.8rem; text-transform: uppercase; color: #888; font-weight: 700; }

        /* --- TABLES --- */
        .tbl-box { overflow-x: auto; border-radius: 10px; border: 1px solid #eee; }
        table { width: 100%; border-collapse: collapse; min-width: 700px; background: white; }
        th { text-align: left; padding: 15px; background: #FAFAFA; font-size: 0.75rem; text-transform: uppercase; color: #555; font-weight: 800; }
        td { padding: 12px 15px; border-bottom: 1px solid #f9f9f9; font-size: 0.9rem; font-weight: 600; color: #333; vertical-align: middle; }
        
        /* --- BADGES --- */
        .badge { padding: 5px 10px; border-radius: 6px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; display: inline-block; }
        .bg-new { background: #FFF3E0; color: #F57C00; } /* Pending */
        .bg-cook { background: #E3F2FD; color: #1976D2; } /* Cooking */
        .bg-out { background: #F3E5F5; color: #7B1FA2; } /* Out */
        .bg-done { background: #E8F5E9; color: #2E7D32; } /* Completed */
        .bg-can { background: #FFEBEE; color: #C62828; } /* Cancelled */

        /* --- FORMS & BUTTONS --- */
        .btn { padding: 10px 20px; border: none; border-radius: 8px; font-weight: 700; cursor: pointer; transition: 0.2s; display: inline-flex; align-items: center; gap: 8px; font-size: 0.9rem; }
        .btn:hover { filter: brightness(1.1); transform: translateY(-1px); }
        .b-prim { background: var(--brand); color: white; }
        .b-dark { background: var(--dark); color: white; }
        .b-succ { background: var(--success); color: white; }
        .b-dang { background: var(--danger); color: white; }
        .b-sm { padding: 6px 12px; font-size: 0.8rem; }

        .inp { width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 8px; margin-bottom: 15px; outline: none; }
        .inp:focus { border-color: var(--brand); }

        /* --- MODAL --- */
        .modal { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 2000; display: none; align-items: center; justify-content: center; backdrop-filter: blur(3px); }
        .modal-box { background: white; width: 550px; max-width: 90%; max-height: 90vh; padding: 30px; border-radius: 20px; overflow-y: auto; animation: popIn 0.3s; }
        @keyframes popIn { from{transform:scale(0.9); opacity:0;} to{transform:scale(1); opacity:1;} }
        .close-x { float: right; font-size: 1.5rem; cursor: pointer; color: #aaa; }

        /* --- THERMAL RECEIPT (Print) --- */
        #invoice-layout { display: none; width: 80mm; padding: 5mm; background: white; color: black; font-family: 'Courier New', monospace; }
        @media print {
            body * { visibility: hidden; }
            #invoice-layout, #invoice-layout * { visibility: visible; }
            #invoice-layout { position: absolute; left: 0; top: 0; display: block; }
        }

        /* --- UTILS --- */
        .switch { position: relative; display: inline-block; width: 40px; height: 22px; }
        .switch input { opacity: 0; width: 0; height: 0; }
        .slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #ccc; transition: .4s; border-radius: 34px; }
        .slider:before { position: absolute; content: ""; height: 16px; width: 16px; left: 3px; bottom: 3px; background-color: white; transition: .4s; border-radius: 50%; }
        input:checked + .slider { background-color: var(--success); }
        input:checked + .slider:before { transform: translateX(18px); }

        .hide { display: none !important; }
        .flex-between { display: flex; justify-content: space-between; align-items: center; }
    </style>
<link rel="me" href="https://www.blogger.com/profile/18035977914919880974" />
<meta name='google-adsense-platform-account' content='ca-host-pub-1556223355139109'/>
<meta name='google-adsense-platform-domain' content='blogspot.com'/>
</head>
<body>

    <!-- INVOICE TEMPLATE (Hidden) -->
    <div id="invoice-layout">
        <center>
            <h2 style="margin:0;">GOVINDA</h2>
            <p style="font-size:12px; margin:5px;">ISKCON Hadapsar, Pune</p>
            <p style="border-bottom:1px dashed #000; padding-bottom:5px;">Original Receipt</p>
        </center>
        <div style="font-size:12px; margin-top:10px;">
            Order: <b id="inv-id">#0000</b><br>
            Customer: <span id="inv-name">--</span><br>
            Time: <span id="inv-date">--</span>
        </div>
        <table style="width:100%; font-size:12px; margin-top:10px; border-top:1px dashed #000;">
            <thead><tr style="text-align:left;"><th>Item</th><th style="text-align:right;">Amt</th></tr></thead>
            <tbody id="inv-items"></tbody>
        </table>
        <div style="text-align:right; font-size:12px; margin-top:10px; border-top:1px dashed #000; padding-top:5px;">
            <b>TOTAL: <span id="inv-total">0</span></b>
        </div>
        <center style="font-size:10px; margin-top:15px;">** Hare Krishna **</center>
    </div>

    <!-- AUTH SCREEN -->
    <div id="view-auth">
        <div class="auth-box">
            <h1 style="color:var(--brand); font-weight:900;"><i class="fa-solid fa-om"></i> GOVINDA HQ</h1>
            <p style="color:#888; margin-bottom:25px;">Admin Control Panel</p>
            <input type="email" id="login-email" class="auth-inp" placeholder="Admin Email">
            <input type="password" id="login-pass" class="auth-inp" placeholder="Password">
            <button class="btn b-prim" style="width:100%; justify-content:center; padding:15px;" onclick="handleLogin()">SECURE LOGIN</button>
            <p id="auth-err" style="color:red; font-size:0.8rem; margin-top:15px;"></p>
        </div>
    </div>

    <!-- SIDEBAR -->
    <aside>
        <div class="logo"><span><i class="fa-solid fa-om"></i></span> GOVINDA HQ</div>
        <div class="nav-list">
            <div class="nav-btn active" onclick="nav('dashboard', this)"><i class="fa-solid fa-chart-pie"></i> Dashboard</div>
            <div class="nav-btn" onclick="nav('menu', this)"><i class="fa-solid fa-utensils"></i> Menu & Cats</div>
            <div class="nav-btn" onclick="nav('orders', this)">
                <i class="fa-solid fa-bell"></i> Orders 
                <span id="nav-badge" style="margin-left:auto; background:var(--danger); color:white; padding:2px 8px; border-radius:10px; font-size:0.7rem;">0</span>
            </div>
            <div class="nav-btn" onclick="nav('marketing', this)"><i class="fa-solid fa-bullhorn"></i> Banners/Coupons</div>
            <div class="nav-btn" onclick="nav('drivers', this)"><i class="fa-solid fa-motorcycle"></i> Drivers</div>
        </div>
        <div style="padding:20px; cursor:pointer;" onclick="logout()">
            <div style="background:#2C3035; padding:15px; border-radius:12px; display:flex; align-items:center; gap:10px;">
                <i class="fa-solid fa-right-from-bracket" style="color:var(--danger);"></i> 
                <span style="font-weight:700; color:white;">Logout</span>
            </div>
        </div>
    </aside>

    <!-- MAIN -->
    <main>
        <header>
            <div class="h-title" id="page-title">DASHBOARD</div>
            
            <!-- MASTER SWITCH -->
            <div id="store-toggle" class="store-switch online">
                <div style="font-weight:700; font-size:0.9rem;" id="store-status-text">STORE ONLINE</div>
                <label class="switch">
                    <input type="checkbox" id="master-switch" checked onchange="toggleStore(this.checked)">
                    <span class="slider"></span>
                </label>
            </div>
        </header>

        <div class="content">

            <!-- 1. DASHBOARD -->
            <div id="view-dashboard">
                <div class="grid-4">
                    <div class="card" style="border-left:5px solid var(--brand)">
                        <div class="kpi-lbl">Total Sales</div>
                        <div class="kpi-val" id="d-sales">₹0</div>
                    </div>
                    <div class="card" style="border-left:5px solid var(--success)">
                        <div class="kpi-lbl">Completed Orders</div>
                        <div class="kpi-val" id="d-orders">0</div>
                    </div>
                    <div class="card" style="border-left:5px solid var(--warn)">
                        <div class="kpi-lbl">Pending Kitchen</div>
                        <div class="kpi-val" id="d-pending">0</div>
                    </div>
                    <div class="card" style="border-left:5px solid var(--dark)">
                        <div class="kpi-lbl">Total Menu Items</div>
                        <div class="kpi-val" id="d-items">0</div>
                    </div>
                </div>

                <div class="card">
                    <h3>Weekly Revenue</h3>
                    <canvas id="sales-chart" style="max-height:300px; width:100%;"></canvas>
                </div>
            </div>

            <!-- 2. MENU & CATEGORIES -->
            <div id="view-menu" class="hide">
                <div class="grid-2">
                    <!-- Categories Column -->
                    <div class="card" style="height:fit-content;">
                        <div class="flex-between" style="margin-bottom:15px;">
                            <h3>Categories</h3>
                            <button class="btn b-dark b-sm" onclick="modal('m-cat')">+ Add New</button>
                        </div>
                        <div id="cat-list" style="display:flex; flex-direction:column; gap:10px;"></div>
                    </div>

                    <!-- Menu Items Column -->
                    <div class="card">
                        <div class="flex-between" style="margin-bottom:15px;">
                            <h3>Dishes</h3>
                            <button class="btn b-prim b-sm" onclick="modal('m-item')">+ Add Dish</button>
                        </div>
                        <div class="tbl-box">
                            <table id="item-list">
                                <thead><tr><th>Dish</th><th>Price</th><th>Stock</th><th>Action</th></tr></thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3. ORDERS -->
            <div id="view-orders" class="hide">
                <div class="card">
                    <div class="flex-between" style="margin-bottom:15px;">
                        <h3>Live Orders</h3>
                        <div style="font-size:0.8rem; color:var(--success); font-weight:700;"><i class="fa-solid fa-circle fa-beat-fade"></i> Live Sync Active</div>
                    </div>
                    <div class="tbl-box">
                        <table id="order-list">
                            <thead><tr><th>ID</th><th>Customer</th><th>Amount</th><th>Status</th><th>Driver</th><th>Action</th></tr></thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- 4. MARKETING -->
            <div id="view-marketing" class="hide">
                <div class="grid-2">
                    <div class="card">
                        <div class="flex-between"><h3>Banners</h3> <button class="btn b-prim b-sm" onclick="modal('m-ban')">+ Add</button></div>
                        <div id="ban-list" style="margin-top:15px; display:grid; grid-template-columns:1fr 1fr; gap:10px;"></div>
                    </div>
                    <div class="card">
                        <div class="flex-between"><h3>Coupons</h3> <button class="btn b-succ b-sm" onclick="modal('m-coup')">+ Create</button></div>
                        <div id="coup-list" style="margin-top:15px;"></div>
                    </div>
                </div>
            </div>

            <!-- 5. DRIVERS -->
            <div id="view-drivers" class="hide">
                <div class="card">
                    <h3>Delivery Partners</h3>
                    <div class="tbl-box" style="margin-top:15px;">
                        <table id="driver-list">
                            <thead><tr><th>Name</th><th>Phone</th><th>Status</th><th>Action</th></tr></thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </main>

    <!-- MODALS -->

    <!-- Add Category -->
    <div id="m-cat" class="modal">
        <div class="modal-box">
            <span class="close-x" onclick="shut('m-cat')">&times;</span>
            <h3>Add Category</h3>
            <label>Category Name</label>
            <input type="text" id="c-name" class="inp" placeholder="e.g. Rice, Thali">
            <label>Image URL (Circular)</label>
            <input type="text" id="c-img" class="inp" placeholder="https://...">
            <button class="btn b-prim" style="width:100%" onclick="saveCat()">SAVE CATEGORY</button>
        </div>
    </div>

    <!-- Add Item -->
    <div id="m-item" class="modal">
        <div class="modal-box">
            <span class="close-x" onclick="shut('m-item')">&times;</span>
            <h3>Add Dish</h3>
            <input type="hidden" id="i-id">
            <label>Dish Name</label><input type="text" id="i-name" class="inp">
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
                <div><label>Category</label><select id="i-cat" class="inp"></select></div>
                <div><label>Price (₹)</label><input type="number" id="i-price" class="inp"></div>
            </div>
            <label>Description</label><input type="text" id="i-desc" class="inp">
            <label>Image URL</label><input type="text" id="i-img" class="inp">
            <label>Stock Count</label><input type="number" id="i-stk" class="inp" value="50">
            <button class="btn b-prim" style="width:100%" onclick="saveItem()">PUBLISH DISH</button>
        </div>
    </div>

    <!-- Order Management -->
    <div id="m-order" class="modal">
        <div class="modal-box">
            <div class="flex-between"><h3>Manage Order</h3> <span class="close-x" onclick="shut('m-order')">&times;</span></div>
            <div id="k-order-body" style="margin-top:15px;"></div>
        </div>
    </div>

    <!-- Marketing Modals -->
    <div id="m-ban" class="modal">
        <div class="modal-box">
            <span class="close-x" onclick="shut('m-ban')">&times;</span>
            <h3>New Banner</h3>
            <label>Image URL (Landscape)</label><input type="text" id="b-img" class="inp">
            <button class="btn b-prim" onclick="saveBan()" style="width:100%">UPLOAD</button>
        </div>
    </div>
    <div id="m-coup" class="modal">
        <div class="modal-box">
            <span class="close-x" onclick="shut('m-coup')">&times;</span>
            <h3>New Coupon</h3>
            <label>Code (e.g. SAVE50)</label><input type="text" id="cp-code" class="inp" style="text-transform:uppercase;">
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
                <div><label>Value</label><input type="number" id="cp-val" class="inp"></div>
                <div><label>Type</label><select id="cp-type" class="inp"><option value="flat">Flat ₹</option><option value="percent">%</option></select></div>
            </div>
            <label>Min Order Amount</label><input type="number" id="cp-min" class="inp">
            <button class="btn b-succ" onclick="saveCoup()" style="width:100%">LAUNCH COUPON</button>
        </div>
    </div>

    <!-- FIREBASE & LOGIC -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/9.22.0/firebase-app.js";
        import { getAuth, signInWithEmailAndPassword, signOut } from "https://www.gstatic.com/firebasejs/9.22.0/firebase-auth.js";
        import { getDatabase, ref, update, onValue, set, push, remove } from "https://www.gstatic.com/firebasejs/9.22.0/firebase-database.js";

        const firebaseConfig = {
  apiKey: "AIzaSyAn38HlPSpz7yRZUmDG7qnedplFjv3WvAE",
  authDomain: "iskcon-food.firebaseapp.com",
  databaseURL: "https://iskcon-food-default-rtdb.firebaseio.com",
  projectId: "iskcon-food",
  storageBucket: "iskcon-food.firebasestorage.app",
  messagingSenderId: "987150159471",
  appId: "1:987150159471:web:c5f8506191ef06d147479a"
};

        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getDatabase(app);

        // --- DATA STORE ---
        let DB = { orders: [], items: [], cats: [], drivers: [], banners: [], coupons: [] };

        // --- AUTH ---
        window.handleLogin = () => {
            const e = document.getElementById('login-email').value;
            const p = document.getElementById('login-pass').value;
            signInWithEmailAndPassword(auth, e, p)
                .then(() => { document.getElementById('view-auth').style.display='none'; initApp(); })
                .catch(err => document.getElementById('auth-err').innerText = "Invalid Credentials");
        };
        window.logout = () => signOut(auth).then(() => location.reload());

        // --- APP INIT ---
        function initApp() {
            // Chart Setup
            const ctx = document.getElementById('sales-chart');
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                    datasets: [{ label: 'Revenue (₹)', data: [5000, 7000, 4500, 8000, 6000, 9500, 12000], borderColor: '#FF6D00', tension: 0.4, fill: false }]
                }
            });

            // Listen to Data
            onValue(ref(db), (snap) => {
                const d = snap.val() || {};
                
                // Store Status
                const isOpen = d.settings?.store_open ?? true;
                const sw = document.getElementById('store-toggle');
                const cb = document.getElementById('master-switch');
                cb.checked = isOpen;
                document.getElementById('store-status-text').innerText = isOpen ? "STORE ONLINE" : "STORE OFFLINE";
                if(isOpen) { sw.classList.add('online'); sw.classList.remove('offline'); }
                else { sw.classList.add('offline'); sw.classList.remove('online'); }

                // Parse Data
                DB.cats = d.categories ? Object.entries(d.categories).map(([k,v])=>({id:k, ...v})) : [];
                DB.items = d.menu ? Object.entries(d.menu).map(([k,v])=>({id:k, ...v})) : [];
                DB.orders = d.orders ? Object.entries(d.orders).map(([k,v])=>({id:k, ...v})) : [];
                DB.drivers = d.deliveryPartners ? Object.entries(d.deliveryPartners).map(([k,v])=>({id:k, ...v})) : [];
                DB.banners = d.sliders ? Object.entries(d.sliders).map(([k,v])=>({id:k, ...v})) : [];
                DB.coupons = d.coupons ? Object.entries(d.coupons).map(([k,v])=>({id:k, ...v})) : [];

                renderUI();
            });
        }

        function renderUI() {
            // Dashboard KPIs
            const completed = DB.orders.filter(o => o.status === 'completed');
            const revenue = completed.reduce((sum, o) => sum + (parseInt(o.total)||0), 0);
            const pending = DB.orders.filter(o => ['pending','placed','cooking'].includes(o.status)).length;
            
            document.getElementById('d-sales').innerText = '₹' + revenue;
            document.getElementById('d-orders').innerText = completed.length;
            document.getElementById('d-pending').innerText = pending;
            document.getElementById('d-items').innerText = DB.items.length;
            document.getElementById('nav-badge').innerText = pending;

            // Categories
            const cList = document.getElementById('cat-list'); cList.innerHTML = '';
            const cSel = document.getElementById('i-cat'); cSel.innerHTML = '';
            
            DB.cats.forEach(c => {
                cList.innerHTML += `
                <div style="display:flex; align-items:center; justify-content:space-between; background:#f9f9f9; padding:10px; border-radius:10px;">
                    <div style="display:flex; align-items:center; gap:10px;">
                        <img src="${c.image}" style="width:40px; height:40px; border-radius:50%; object-fit:cover; border:2px solid white; box-shadow:0 2px 5px rgba(0,0,0,0.1);">
                        <b>${c.name}</b>
                    </div>
                    <div>
                        <i class="fa-solid fa-trash" style="color:var(--danger); cursor:pointer;" onclick="del('categories/${c.id}')"></i>
                    </div>
                </div>`;
                cSel.innerHTML += `<option value="${c.name}">${c.name}</option>`;
            });

            // Items
            const tItem = document.getElementById('item-list').getElementsByTagName('tbody')[0];
            tItem.innerHTML = '';
            DB.items.forEach(i => {
                tItem.innerHTML += `<tr>
                    <td><div style="display:flex; gap:10px; align-items:center;"><img src="${i.image}" style="width:30px; height:30px; border-radius:4px; object-fit:cover;"> ${i.name}</div></td>
                    <td>₹${i.price}</td>
                    <td>${i.stock}</td>
                    <td>
                        <button class="btn b-dark b-sm" onclick="editItem('${i.id}')"><i class="fa-solid fa-pen"></i></button>
                        <i class="fa-solid fa-trash" style="color:red; margin-left:10px; cursor:pointer;" onclick="del('menu/${i.id}')"></i>
                    </td>
                </tr>`;
            });

            // Orders (Sorted Newest First)
            const tOrd = document.getElementById('order-list').getElementsByTagName('tbody')[0];
            tOrd.innerHTML = '';
            DB.orders.sort((a,b)=>b.createdAt - a.createdAt).forEach(o => {
                let badge = 'bg-new';
                if(o.status=='cooking') badge='bg-cook';
                if(o.status=='out_for_delivery') badge='bg-out';
                if(o.status=='completed') badge='bg-done';
                if(o.status=='cancelled') badge='bg-can';

                tOrd.innerHTML += `<tr>
                    <td>#${o.id.slice(-4)}</td>
                    <td>${o.userName}<br><small>${o.userPhone}</small></td>
                    <td>₹${o.total}</td>
                    <td><span class="badge ${badge}">${o.status.replace(/_/g, ' ')}</span></td>
                    <td>${o.driverName || '<span style="color:#aaa">--</span>'}</td>
                    <td><button class="btn b-prim b-sm" onclick="manageOrder('${o.id}')">View</button></td>
                </tr>`;
            });

            // Drivers
            const tDry = document.getElementById('driver-list').getElementsByTagName('tbody')[0];
            tDry.innerHTML = '';
            DB.drivers.forEach(d => {
                let status = d.blocked ? '<span class="badge bg-can">Blocked</span>' : (!d.approved ? '<span class="badge bg-new">Pending</span>' : '<span class="badge bg-done">Active</span>');
                tDry.innerHTML += `<tr>
                    <td>${d.name}</td>
                    <td>${d.phone}</td>
                    <td>${status}</td>
                    <td>
                        ${!d.approved ? `<button class="btn b-succ b-sm" onclick="updDriver('${d.id}', {approved:true})">Approve</button>` : ''}
                        ${d.approved && !d.blocked ? `<button class="btn b-dang b-sm" onclick="updDriver('${d.id}', {blocked:true})">Block</button>` : ''}
                        ${d.blocked ? `<button class="btn b-dark b-sm" onclick="updDriver('${d.id}', {blocked:false})">Unblock</button>` : ''}
                    </td>
                </tr>`;
            });
            
            // Marketing
            document.getElementById('ban-list').innerHTML = DB.banners.map(b=>`
                <div style="position:relative;">
                    <img src="${b.image}" style="width:100%; height:100px; object-fit:cover; border-radius:8px;">
                    <i class="fa-solid fa-trash" style="position:absolute; top:5px; right:5px; background:white; padding:5px; border-radius:50%; color:red; cursor:pointer;" onclick="del('sliders/${b.id}')"></i>
                </div>`).join('');
                
            document.getElementById('coup-list').innerHTML = DB.coupons.map(c=>`
                <div style="display:flex; justify-content:space-between; padding:10px; background:#f0f0f0; margin-bottom:5px; border-radius:8px;">
                    <b>${c.id} (${c.type=='flat'?'₹':'%'}${c.value} OFF)</b>
                    <i class="fa-solid fa-trash" style="color:red; cursor:pointer;" onclick="del('coupons/${c.id}')"></i>
                </div>`).join('');
        }

        // --- ACTIONS ---
        window.nav = (page, el) => {
            ['dashboard','menu','orders','marketing','drivers'].forEach(id => document.getElementById('view-'+id).classList.add('hide'));
            document.getElementById('view-'+page).classList.remove('hide');
            document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
            el.classList.add('active');
            document.getElementById('page-title').innerText = page.toUpperCase();
        };

        window.modal = (id) => {
            if(id=='m-item') document.getElementById('i-id').value = '';
            document.getElementById(id).style.display = 'flex';
        };
        window.shut = (id) => document.getElementById(id).style.display = 'none';
        
        // --- DATABASE WRITES ---
        window.toggleStore = (val) => update(ref(db, 'settings'), { store_open: val });
        window.del = (path) => { if(confirm("Are you sure?")) remove(ref(db, path)); };
        
        window.saveCat = () => {
            const n = document.getElementById('c-name').value;
            const img = document.getElementById('c-img').value;
            if(!n) return alert("Name required");
            const key = n.toLowerCase().replace(/\s/g, '_');
            update(ref(db, 'categories/'+key), { name: n, image: img, active: true });
            shut('m-cat');
        };

        window.saveItem = () => {
            const id = document.getElementById('i-id').value || push(ref(db, 'menu')).key;
            update(ref(db, 'menu/'+id), {
                name: document.getElementById('i-name').value,
                category: document.getElementById('i-cat').value,
                price: parseInt(document.getElementById('i-price').value),
                description: document.getElementById('i-desc').value,
                image: document.getElementById('i-img').value,
                stock: parseInt(document.getElementById('i-stk').value),
                active: true
            });
            shut('m-item');
        };

        window.saveBan = () => { push(ref(db, 'sliders'), { image: document.getElementById('b-img').value }); shut('m-ban'); };
        window.saveCoup = () => {
            const code = document.getElementById('cp-code').value.toUpperCase();
            set(ref(db, 'coupons/'+code), {
                value: parseInt(document.getElementById('cp-val').value),
                type: document.getElementById('cp-type').value,
                minOrder: parseInt(document.getElementById('cp-min').value),
                active: true
            });
            shut('m-coup');
        };

        window.updDriver = (id, data) => update(ref(db, 'deliveryPartners/'+id), data);
        
        window.manageOrder = (oid) => {
            const o = DB.orders.find(x => x.id === oid);
            const driverOpts = DB.drivers.filter(d => d.approved && !d.blocked).map(d => `<option value="${d.id}">${d.name}</option>`).join('');

            document.getElementById('k-order-body').innerHTML = `
                <div style="background:#f9f9f9; padding:15px; border-radius:10px;">
                    <p><b>Customer:</b> ${o.userName} (${o.userPhone})</p>
                    <p><b>Address:</b> ${o.address}</p>
                    <p><b>Note:</b> ${o.items.map(i=>`${i.qty}x ${i.name}`).join(', ')}</p>
                    <h3 style="margin-top:10px;">Total: ₹${o.total}</h3>
                </div>
                <div style="margin-top:15px; display:grid; grid-template-columns:1fr 1fr; gap:10px;">
                    <button class="btn b-dark" onclick="printBill('${o.id}')"><i class="fa-solid fa-print"></i> Print</button>
                    ${o.status !== 'cancelled' ? `<button class="btn b-dang" onclick="updateStatus('${o.id}','cancelled')">Cancel</button>` : ''}
                </div>
                
                <hr style="margin:15px 0; border:0; border-top:1px dashed #ddd;">
                
                <h4>Update Status</h4>
                <div style="display:flex; gap:5px; flex-wrap:wrap; margin-top:5px;">
                    <button class="btn b-sm" style="background:#FFF3E0; color:#F57C00" onclick="updateStatus('${o.id}','cooking')">Cooking</button>
                    <button class="btn b-sm" style="background:#E3F2FD; color:#1976D2" onclick="updateStatus('${o.id}','driver_assigned')">Ready</button>
                    <button class="btn b-sm" style="background:#F3E5F5; color:#7B1FA2" onclick="updateStatus('${o.id}','out_for_delivery')">Out</button>
                    <button class="btn b-sm" style="background:#E8F5E9; color:#2E7D32" onclick="updateStatus('${o.id}','completed')">Done</button>
                </div>

                <div style="margin-top:15px;">
                    <label>Assign Driver</label>
                    <div style="display:flex; gap:10px;">
                        <select id="sel-driver-${o.id}" class="inp" style="margin:0;">${driverOpts}</select>
                        <button class="btn b-prim" onclick="assignDriver('${o.id}')">Assign</button>
                    </div>
                </div>
            `;
            modal('m-order');
        };

        window.updateStatus = (oid, st) => update(ref(db, 'orders/'+oid), { status: st });
        
        window.assignDriver = (oid) => {
            const did = document.getElementById(`sel-driver-${oid}`).value;
            const dname = DB.drivers.find(d=>d.id===did).name;
            update(ref(db, 'orders/'+oid), { driverId: did, driverName: dname, status: 'driver_assigned' });
            shut('m-order');
        };

        window.printBill = (oid) => {
            const o = DB.orders.find(x => x.id === oid);
            document.getElementById('inv-id').innerText = '#' + o.id.slice(-4);
            document.getElementById('inv-name').innerText = o.userName;
            document.getElementById('inv-date').innerText = new Date(o.createdAt).toLocaleString();
            document.getElementById('inv-total').innerText = '₹' + o.total;
            
            const tbody = document.getElementById('inv-items');
            tbody.innerHTML = '';
            o.items.forEach(i => tbody.innerHTML += `<tr><td>${i.name}</td><td style="text-align:right;">${i.price*i.qty}</td></tr>`);
            
            window.print();
        };

        window.editItem = (id) => {
            const i = DB.items.find(x => x.id === id);
            document.getElementById('i-id').value = i.id;
            document.getElementById('i-name').value = i.name;
            document.getElementById('i-cat').value = i.category;
            document.getElementById('i-price').value = i.price;
            document.getElementById('i-desc').value = i.description || '';
            document.getElementById('i-img').value = i.image;
            document.getElementById('i-stk').value = i.stock;
            modal('m-item');
        };

    </script>
</body>
</html>
